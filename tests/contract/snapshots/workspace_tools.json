{
  "create_email_draft": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "input": {
      "$defs": {
        "CreateEmailDraftInput": {
          "additionalProperties": false,
          "properties": {
            "body": {
              "maxLength": 8000,
              "minLength": 1,
              "title": "Body",
              "type": "string"
            },
            "idempotency_key": {
              "maxLength": 128,
              "minLength": 8,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "title": "Idempotency Key",
              "type": "string"
            },
            "recipient": {
              "anyOf": [
                {
                  "maxLength": 254,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Recipient"
            },
            "subject": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Subject",
              "type": "string"
            }
          },
          "required": [
            "subject",
            "body",
            "idempotency_key"
          ],
          "title": "CreateEmailDraftInput",
          "type": "object"
        }
      },
      "properties": {
        "request": {
          "$ref": "#/$defs/CreateEmailDraftInput"
        }
      },
      "required": [
        "request"
      ],
      "title": "create_email_draftArguments",
      "type": "object"
    },
    "output": {
      "properties": {
        "replayed": {
          "default": false,
          "title": "Replayed",
          "type": "boolean"
        },
        "status": {
          "default": "draft",
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "subject"
      ],
      "title": "EmailDraft",
      "type": "object"
    }
  },
  "create_interview_hold": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "input": {
      "$defs": {
        "CreateHoldInput": {
          "additionalProperties": false,
          "properties": {
            "duration_minutes": {
              "maximum": 240,
              "minimum": 15,
              "title": "Duration Minutes",
              "type": "integer"
            },
            "idempotency_key": {
              "maxLength": 128,
              "minLength": 8,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "title": "Idempotency Key",
              "type": "string"
            },
            "start": {
              "format": "date-time",
              "title": "Start",
              "type": "string"
            },
            "title": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            }
          },
          "required": [
            "start",
            "duration_minutes",
            "title",
            "idempotency_key"
          ],
          "title": "CreateHoldInput",
          "type": "object"
        }
      },
      "properties": {
        "request": {
          "$ref": "#/$defs/CreateHoldInput"
        }
      },
      "required": [
        "request"
      ],
      "title": "create_interview_holdArguments",
      "type": "object"
    },
    "output": {
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "replayed": {
          "default": false,
          "title": "Replayed",
          "type": "boolean"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "status": {
          "default": "tentative",
          "title": "Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "title"
      ],
      "title": "Hold",
      "type": "object"
    }
  },
  "free_slots": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "input": {
      "properties": {
        "count": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "days_ahead": {
          "default": 7,
          "maximum": 30,
          "minimum": 1,
          "title": "Days Ahead",
          "type": "integer"
        },
        "duration_minutes": {
          "default": 30,
          "maximum": 240,
          "minimum": 15,
          "title": "Duration Minutes",
          "type": "integer"
        }
      },
      "title": "free_slotsArguments",
      "type": "object"
    },
    "output": {
      "$defs": {
        "Slot": {
          "properties": {
            "end": {
              "format": "date-time",
              "title": "End",
              "type": "string"
            },
            "start": {
              "format": "date-time",
              "title": "Start",
              "type": "string"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "title": "Slot",
          "type": "object"
        }
      },
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/Slot"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "SlotList",
      "type": "object"
    }
  }
}
