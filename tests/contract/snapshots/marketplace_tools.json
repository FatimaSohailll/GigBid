          "type": "number"
        },
        "p50": {
          "title": "P50",
          "type": "number"
        },
        "p75": {
          "title": "P75",
          "type": "number"
        },
        "sample_size": {
          "title": "Sample Size",
          "type": "integer"
        },
        "skills": {
          "items": {
