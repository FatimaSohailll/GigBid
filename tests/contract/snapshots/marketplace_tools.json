        },
        "client_id": {
          "title": "Client Id",
          "type": "string"
        },
        "connects_cost": {
          "title": "Connects Cost",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "duration_days": {
          "title": "Duration Days",
          "type": "integer"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "posted_at": {
          "format": "date-time",
          "title": "Posted At",
          "type": "string"
        },
        "required_skills": {
          "items": {
            "type": "string"
          },
          "title": "Required Skills",
          "type": "array"
        },
        "screening_questions": {
          "items": {
            "type": "string"
          },
          "title": "Screening Questions",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
