  "get_client_history": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true
    },
    "description": "Get one client's record by client_id: completed projects, average rating, reviews, total spend and whether payment is verified. Use this to judge a client, not a job.",
    "input": {
      "properties": {
        "client_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Client Id",
          "type": "string"
        }
      },
      "required": [
        "client_id"
      ],
      "title": "get_client_historyArguments",
      "type": "object"
    },
    "output": {
      "$defs": {
        "ClientReview": {
          "properties": {
            "comment": {
              "title": "Comment",
              "type": "string"
            },
            "rating": {
              "title": "Rating",
              "type": "number"
            }
          },
          "required": [
            "rating",
            "comment"
          ],
          "title": "ClientReview",
          "type": "object"
        }
      },
      "properties": {
        "average_rating": {
          "title": "Average Rating",
          "type": "number"
        },
        "client_id": {
          "title": "Client Id",
          "type": "string"
        },
        "completed_projects": {
          "title": "Completed Projects",
          "type": "integer"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "industry": {
          "title": "Industry",
          "type": "string"
        },
        "payment_verified": {
          "title": "Payment Verified",
          "type": "boolean"
        },
        "reviews": {
          "items": {
            "$ref": "#/$defs/ClientReview"
          },
          "title": "Reviews",
          "type": "array"
        },
        "total_spent_usd": {
          "title": "Total Spent Usd",
          "type": "number"
        }
      },
      "required": [
        "client_id",
        "display_name",
        "industry",
        "completed_projects",
        "average_rating",
        "payment_verified",
        "total_spent_usd"
      ],
      "title": "ClientHistory",
      "type": "object"
    }
