            },
            "dry_run": {
              "default": false,
              "description": "If true, return what would be sent and what it costs, and send nothing.",
              "title": "Dry Run",
              "type": "boolean"
            },
            "idempotency_key": {
              "description": "Unique per intended action. Reuse the same value when retrying it.",
              "maxLength": 128,
              "minLength": 8,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "title": "Idempotency Key",
              "type": "string"
            }
          },
          "required": [
            "conversation_id",
            "body",
            "idempotency_key"
          ],
          "title": "SendMessageInput",
          "type": "object"
        }
      },
      "properties": {
        "request": {
          "$ref": "#/$defs/SendMessageInput"
        }
      },
      "required": [
        "request"
      ],
      "title": "send_messageArguments",
      "type": "object"
    },
    "server": "marketplace"
  },
  "submit_proposal": {
    "description": "Submit a draft and spend Connects. Only after explicit human approval.",
    "parameters": {
      "$defs": {
        "SubmitProposalInput": {
          "additionalProperties": false,
