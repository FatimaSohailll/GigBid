  "search_evidence": {
    "description": "Find portfolio evidence for a requirement. Returns type, source, date and outcome.",
    "parameters": {
      "$defs": {
        "EvidenceFilters": {
          "additionalProperties": false,
          "properties": {
            "client_industries": {
              "items": {
                "type": "string"
              },
              "maxItems": 20,
              "title": "Client Industries",
              "type": "array"
            },
            "min_year": {
              "anyOf": [
                {
                  "maximum": 2100,
                  "minimum": 1990,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Min Year"
            },
            "outcomes": {
              "items": {
                "type": "string"
              },
              "maxItems": 5,
              "title": "Outcomes",
              "type": "array"
            },
            "project": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Project"
            },
            "skills": {
              "items": {
                "type": "string"
              },
              "maxItems": 20,
              "title": "Skills",
              "type": "array"
            },
            "types": {
              "items": {
                "type": "string"
              },
              "maxItems": 10,
              "title": "Types",
              "type": "array"
            }
          },
          "title": "EvidenceFilters",
          "type": "object"
        }
      },
      "properties": {
        "filters": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceFilters"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "k": {
          "default": 5,
          "maximum": 20,
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "requirement": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Requirement",
          "type": "string"
        }
      },
      "required": [
        "requirement"
      ],
      "title": "search_evidenceArguments",
      "type": "object"
    },
    "server": "portfolio"
  },
  "search_jobs": {
    "description": "Search open jobs by text and required skills, newest first.",
