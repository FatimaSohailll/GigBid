{
  "create_email_draft": {
    "description": "Save an email as a draft. It is never sent automatically.",
    "parameters": {
      "$defs": {
        "CreateEmailDraftInput": {
          "additionalProperties": false,
          "properties": {
            "body": {
              "maxLength": 8000,
              "minLength": 1,
              "title": "Body",
              "type": "string"
            },
            "idempotency_key": {
              "maxLength": 128,
              "minLength": 8,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "title": "Idempotency Key",
              "type": "string"
            },
            "recipient": {
              "anyOf": [
                {
                  "maxLength": 254,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Recipient"
            },
            "subject": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Subject",
              "type": "string"
            }
          },
          "required": [
            "subject",
            "body",
            "idempotency_key"
          ],
          "title": "CreateEmailDraftInput",
          "type": "object"
        }
      },
      "properties": {
        "request": {
          "$ref": "#/$defs/CreateEmailDraftInput"
        }
      },
      "required": [
        "request"
      ],
      "title": "create_email_draftArguments",
      "type": "object"
    },
    "server": "workspace"
  },
  "create_interview_hold": {
    "description": "Place a tentative interview hold on the calendar. Only after human approval.",
    "parameters": {
      "$defs": {
        "CreateHoldInput": {
          "additionalProperties": false,
          "properties": {
            "duration_minutes": {
              "maximum": 240,
              "minimum": 15,
              "title": "Duration Minutes",
              "type": "integer"
            },
            "idempotency_key": {
              "maxLength": 128,
              "minLength": 8,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "title": "Idempotency Key",
              "type": "string"
            },
            "start": {
              "format": "date-time",
              "title": "Start",
              "type": "string"
            },
            "title": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            }
          },
          "required": [
            "start",
            "duration_minutes",
            "title",
            "idempotency_key"
          ],
          "title": "CreateHoldInput",
          "type": "object"
        }
      },
      "properties": {
        "request": {
          "$ref": "#/$defs/CreateHoldInput"
        }
      },
      "required": [
        "request"
      ],
      "title": "create_interview_holdArguments",
      "type": "object"
    },
    "server": "workspace"
  },
  "create_proposal_draft": {
    "description": "Create an unsent proposal draft. Costs no Connects. Requires human approval first.",
    "parameters": {
      "$defs": {
        "CreateProposalDraftInput": {
          "additionalProperties": false,
          "properties": {
            "bid_amount": {
              "exclusiveMinimum": 0,
              "maximum": 1000000,
              "title": "Bid Amount",
              "type": "number"
            },
            "cover_letter": {
              "maxLength": 5000,
              "minLength": 1,
              "title": "Cover Letter",
              "type": "string"
            },
            "dry_run": {
              "default": false,
              "description": "If true, return what would be sent and what it costs, and send nothing.",
              "title": "Dry Run",
              "type": "boolean"
            },
            "idempotency_key": {
              "description": "Unique per intended action. Reuse the same value when retrying it.",
              "maxLength": 128,
              "minLength": 8,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "title": "Idempotency Key",
              "type": "string"
            },
            "job_id": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Job Id",
              "type": "string"
            },
            "screening_answers": {
              "items": {
                "maxLength": 2000,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 10,
              "title": "Screening Answers",
              "type": "array"
            }
          },
          "required": [
            "job_id",
            "cover_letter",
            "bid_amount",
            "idempotency_key"
          ],
          "title": "CreateProposalDraftInput",
          "type": "object"
        }
      },
      "properties": {
        "request": {
          "$ref": "#/$defs/CreateProposalDraftInput"
        }
      },
      "required": [
        "request"
      ],
      "title": "create_proposal_draftArguments",
      "type": "object"
    },
    "server": "marketplace"
  },
  "free_slots": {
    "description": "List free calendar slots within working hours, soonest first.",
    "parameters": {
      "properties": {
        "count": {
          "default": 3,
