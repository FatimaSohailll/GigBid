          "default": 7,
          "maximum": 30,
          "minimum": 1,
          "title": "Days Ahead",
          "type": "integer"
        },
        "duration_minutes": {
          "default": 30,
          "maximum": 240,
          "minimum": 15,
          "title": "Duration Minutes",
          "type": "integer"
        }
      },
      "title": "free_slotsArguments",
      "type": "object"
    },
    "server": "workspace"
  },
