            "idempotency_key": {
              "description": "Unique per intended action. Reuse the same value when retrying it.",
              "maxLength": 128,
              "minLength": 8,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "title": "Idempotency Key",
              "type": "string"
            },
            "proposal_id": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Proposal Id",
              "type": "string"
            }
          },
          "required": [
            "proposal_id",
            "idempotency_key"
          ],
          "title": "SubmitProposalInput",
          "type": "object"
        }
      },
      "properties": {
        "request": {
          "$ref": "#/$defs/SubmitProposalInput"
        }
      },
      "required": [
        "request"
      ],
      "title": "submit_proposalArguments",
      "type": "object"
    },
    "server": "marketplace"
  }
