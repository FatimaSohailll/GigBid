# Copy to .env and fill in local values. Never commit .env.

# Application
APP_ENV=development
APP_SECRET_KEY=replace_me
# Encrypts stored OAuth tokens (A4, E4)
TOKEN_ENCRYPTION_KEY=replace_me

# Stores
DATABASE_URL=postgresql+psycopg://gigbid:gigbid@localhost:5432/gigbid
REDIS_URL=redis://localhost:6379/0
# Enables the crash-recovery tests; start the database with: make db
TEST_DATABASE_URL=postgresql://gigbid:gigbid@localhost:5432/gigbid

# Marketplace: gigsim or upwork_live
MARKETPLACE_MODE=gigsim
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=replace_me

# DevSim, the stand-in simulator (format: token=freelancer_id,token2=freelancer_id2)
DEVSIM_API_TOKENS=replace_me=ai_ml_engineer
DEVSIM_ADMIN_TOKEN=replace_me

# Marketplace MCP server (format: bearer:user_id:marketplace_token, comma separated)
MCP_MARKETPLACE_USERS=replace_me
MCP_MARKETPLACE_HOST=127.0.0.1
MCP_MARKETPLACE_PORT=8090
MCP_MARKETPLACE_DB=data/processed/marketplace_mcp.sqlite3
# How the agents reach it
MCP_MARKETPLACE_URL=http://127.0.0.1:8090/mcp
MCP_MARKETPLACE_BEARER_TOKEN=replace_me

# Portfolio MCP server (format: bearer:tenant, comma separated)
MCP_PORTFOLIO_USERS=replace_me
MCP_PORTFOLIO_HOST=127.0.0.1
MCP_PORTFOLIO_PORT=8091
MCP_PORTFOLIO_URL=http://127.0.0.1:8091/mcp
MCP_PORTFOLIO_BEARER_TOKEN=replace_me

# Workspace MCP server (format: bearer:tenant, comma separated)
MCP_WORKSPACE_USERS=replace_me
MCP_WORKSPACE_HOST=127.0.0.1
MCP_WORKSPACE_PORT=8092
MCP_WORKSPACE_DB=data/processed/workspace_mcp.sqlite3
MCP_WORKSPACE_URL=http://127.0.0.1:8092/mcp
MCP_WORKSPACE_BEARER_TOKEN=replace_me

# Retrieval stores. Without QDRANT_URL, Qdrant runs embedded under RAG_DATA_DIR.
RAG_DATA_DIR=data/processed/rag
QDRANT_URL=

# Models: open or paid
MODEL_PROFILE=open
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Tracing (use one)
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Third-party MCP servers
GITHUB_PERSONAL_ACCESS_TOKEN=
UPWORK_OAUTH_CLIENT_ID=
UPWORK_OAUTH_CLIENT_SECRET=
UPWORK_OAUTH_REDIRECT_URI=http://localhost:8000/auth/upwork/callback
